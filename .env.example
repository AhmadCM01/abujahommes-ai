# ==========================================
# AbujaHommes AI — Environment Configuration
# ==========================================

# 1. Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://user:password@localhost:5432/abujahommes
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/abujahommes

# 2. Better Auth Configuration
BETTER_AUTH_SECRET=generate-a-32-byte-random-secret-here-via-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-32-byte-random-secret-here-via-openssl-rand-hex-32
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Google OAuth 2.0 Credentials
# Google Cloud Console -> Authorized origins: http://localhost:3000, https://abujahommes.com
# Google Cloud Console -> Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Redis (Upstash) for Rate Limiting & Hot Paths
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
REDIS_URL=redis://default:token@your-redis-instance.upstash.io:6379

# 5. Email Service (Resend)
# If RESEND_API_KEY is missing, emails remain queued in email_messages and URL is logged to console in dev.
RESEND_API_KEY=re_your_resend_api_key
# In development only, if EMAIL_FROM_TRANSACTIONAL is empty, falls back to onboarding@resend.dev. Required in production.
EMAIL_FROM_TRANSACTIONAL=AbujaHommes <noreply@mail.abujahommes.com>
EMAIL_FROM_UPDATES=AbujaHommes <updates@news.abujahommes.com>

# 6. Legacy Supabase Storage & Database (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 7. FastAPI ML Microservice URL
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=http://127.0.0.1:8000

# 8. Optional Gemini AI API Key for Deep NLP Pidgin / English Parsing
GEMINI_API_KEY=your-gemini-api-key
